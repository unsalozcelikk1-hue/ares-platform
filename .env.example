# ARES Backend — Ortam Değişkenleri
# Bu dosyayı backend/.env olarak kopyalayın: cp .env.example backend/.env

# Backend sunucu portu
PORT=5000

# CORS — izin verilen frontend origin (production'da kısıtlayın)
# Örnek: CORS_ORIGIN=https://ares.yourdomain.com
CORS_ORIGIN=*

# ─────────────────────────────────────────────────
# AI / LLM Entegrasyonu (server.py için — opsiyonel)
# ─────────────────────────────────────────────────
# Cloud LLM API anahtarı (DeepSeek, Groq, OpenAI, OpenRouter)
# ARES_LLM_API_KEY=sk-...

# Kullanılacak sağlayıcı: deepseek | groq | openai | openrouter
# ARES_LLM_PROVIDER=deepseek

# Spesifik model (boş bırakılırsa sağlayıcı varsayılanı kullanılır)
# ARES_LLM_MODEL=deepseek-chat

# Ollama (yerel LLM) — http://localhost:11434 üzerinde çalışıyorsa otomatik tespit edilir.
# API anahtarı gerekmez. Ollama'yı kurun ve bir model pull edin:
# ollama pull llama3

